# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-repro/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data — too large for git, and licence-restricted (FNSPID is CC BY-NC-4.0)
/data/
/texts/
# cloned third-party code (MM-TSFlib)
/external/
*.csv
*.zip
*.parquet
# but keep small result summaries:
!results/summary_*.csv

# Model weights
*.pt
*.pth
*.bin
*.safetensors

# Experiment tracking
mlruns/
mlartifacts/
mlflow.db
.dvc/cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
*.key

# Model checkpoints (P2+)
/checkpoints/
# Per-unit raw predictions of the CPU runners ARE committed (R7): they are the raw outputs every
# Model 1-4 / R1 / R3-FinBERT table is derived from (numbers only, no text). The combined CSVs
# (p2_baselines_predictions.csv, p5_predictions.csv, ...) stay ignored: `--collect-only` rebuilds them.
!/results/p2_baselines/*.csv
!/results/p5_units/*.csv
!/results/r1_train_units/*.csv
!/results/r1_units/*.csv
!/results/r3_finbert_units/*.csv
# R7 toolkit test on Kaggle: the notebook's audit_out/ (synthetic example; reproduce.py INPUTS)
!/results/r7_toolkit_kaggle/*.csv
# cached text embeddings (recomputable; never commit)
/cache/
results/r3_finbert_run.log
# R4 held-out GPU input: holds FNSPID headlines + synthetic fakes; regenerated by
# `python -m src.models.export_r4_inputs` (sha256 asserted) — not redistributed (R7)
results/qwen/r4_heldout_inputs.csv
# R7: reproduce.py logs, toolkit outputs, worked-example data stays tracked
/logs/
audit_out/
examples/audit_out/
!/examples/*.csv

# Streamlit demo (P7.2): its own venv; Time-MMD report texts of the demo examples (no licence → not redistributed)
.venv-app/
/app/data/demo_timemmd_texts.json
